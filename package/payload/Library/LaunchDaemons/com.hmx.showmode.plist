<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique label for launchctl -->
    <key>Label</key>
    <string>com.hmx.showmode</string>

    <!-- Script to execute -->
    <key>Program</key>
    <string>/Library/Scripts/HMX/showmode_cron.sh</string>

    <!-- Run once at system boot -->
    <key>RunAtLoad</key>
    <true/>

    <!-- Also run on the 1st of every month at midnight -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Day</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>0</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <!-- Log stdout and stderr to a dedicated file -->
    <key>StandardOutPath</key>
    <string>/var/log/showmode-cron.log</string>
    <key>StandardErrorPath</key>
    <string>/var/log/showmode-cron.log</string>
</dict>
</plist>
